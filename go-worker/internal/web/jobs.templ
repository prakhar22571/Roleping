package web

import (
	"fmt"
	"roleping-worker/internal/db"
)

templ JobsPage(jobs []db.JobListRow, companies []db.Company) {
	@Layout("Jobs") {
		<form
			class="filters"
			hx-get="/jobs/table"
			hx-target="#jobs-table"
			hx-swap="outerHTML"
			hx-trigger="change, keyup changed delay:300ms from:input[name='search']"
		>
			<select name="companyId">
				<option value="">All companies</option>
				for _, c := range companies {
					<option value={ fmt.Sprintf("%d", c.ID) }>{ c.Name }</option>
				}
			</select>
			<select name="status">
				<option value="">All statuses</option>
				<option value="New">New</option>
				<option value="Applied">Applied</option>
				<option value="Interviewing">Interviewing</option>
				<option value="Rejected">Rejected</option>
				<option value="Offer">Offer</option>
			</select>
			<label style="flex-direction: row; align-items: center; gap: 6px;">
				<input type="checkbox" name="disagreement" value="true"/>
				Model disagreement only
			</label>
			<input type="text" name="search" placeholder="Search title..."/>
		</form>

		@JobsTable(jobs)
	}
}

templ JobsTable(jobs []db.JobListRow) {
	<table id="jobs-table">
		<thead>
			<tr>
				<th>Title</th>
				<th>Company</th>
				<th>Posted</th>
				<th>Verdicts</th>
				<th>Notified</th>
				<th>Status</th>
			</tr>
		</thead>
		<tbody>
			for _, job := range jobs {
				{{ verdicts := ParseVerdicts(job.VerdictsJSON) }}
				<tr>
					<td><a href={ templ.URL(fmt.Sprintf("/jobs/%d", job.ID)) }>{ job.Title }</a></td>
					<td>{ job.CompanyName }</td>
					<td>
						if job.PostedDate != nil {
							{ *job.PostedDate }
						} else {
							—
						}
					</td>
					<td>
						if len(verdicts) == 0 {
							<span class="pending">pending</span>
						} else {
							for i, v := range verdicts {
								if i > 0 {
									{ " / " }
								}
								if v.Match != 0 {
									<span class="match">✓</span>
								} else {
									<span class="no-match">✗</span>
								}
							}
						}
					</td>
					<td>
						if job.Notified {
							sent
						} else {
							—
						}
					</td>
					<td>{ string(job.ApplicationStatus) }</td>
				</tr>
			}
		</tbody>
	</table>
}
